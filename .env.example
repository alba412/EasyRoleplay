# OpenRouter の APIキー。https://openrouter.ai/keys で発行する
OPENROUTER_API_KEY=

# 使用モデル（省略時は deepseek/deepseek-chat）
# OpenRouter のモデル一覧にあるIDを指定する
OPENROUTER_MODEL=

# OpenRouter のダッシュボードでの識別用（省略可）
OPENROUTER_SITE_URL=http://localhost:3000

# APIのベースURL（省略時は https://openrouter.ai/api/v1）
# 互換プロキシやモックへ向けたいときだけ設定する
OPENROUTER_BASE_URL=

# SQLiteの場所（省略時は file:./prisma/dev.db）
# 実装順序7でPostgresへ移行するときにここを差し替える
DATABASE_URL=
